+        e=coupon();d=e['data'];data={'props':{'pageProps':{'initialStoreState':{'couponViewStore':{'couponData':d}}}}}
+        raw='<script id="__NEXT_DATA__" type="application/json">'+json.dumps(data)+'</script>'
